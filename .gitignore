# Local environment overrides
/.env.local

# Input books (may be copyrighted; never commit)
/books/
/epub/

# Personal working files kept out of the public repo: the per-series glossary
# (glossary.example.json is the tracked template) and the private dev journal
# that AGENTS.md asks agents to maintain.
/glossary.json
/docs/journal.html

# Side-by-side review pages built by `just compare` from a run's segments.jsonl.
# They embed the book's source text and its translation, so they belong with the
# books: never committed. Only the illustrated docs under docs/ are tracked.
/*.html

# Runtime artifacts and local data
/runs/
/data/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Built binaries
/tomeshift
/nmt-devserver
/bin/

# Python caches (COMET service / scripts)
__pycache__/
*.pyc
