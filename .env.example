# Copy this file to .env.local and adjust values.
# Keep this file to simple KEY=VALUE entries only.
#
# NO SECRETS IN THIS FILE. The two *_API_KEY settings are either resolved from
# 1Password at launch time via `op run --env-file=.env.op --` (see .env.op), or
# set in your own gitignored .env.local. Left empty, the commands that need
# them are wrapped in `op run`; the ones that are not make no provider call.

# Core runtime
TOMESHIFT_LOG_LEVEL=info

# 1Password account the op:// references in .env.op resolve against. A secret
# reference names a vault, never an account — so with both a work and a personal
# account signed in, leaving this empty lets `op` pick, and a personal project's
# key belongs in the personal account. `op account list` shows the addresses.
OP_ACCOUNT=

# Translation provider. Supported:
#   "http"           bundled dev server / our own contract (`just nmt-dev`)
#   "libretranslate" self-hosted LibreTranslate/Argos
#   "google"         Google Cloud Translation v2 (Basic), API key auth
# Default points at the bundled local NMT dev server.
#
# For the recommended draft engine (Google), the endpoint can be left empty —
# Cloud Translation has one public host and the adapter supplies it:
#   TOMESHIFT_NMT_PROVIDER=google
#   TOMESHIFT_NMT_API_KEY=<your Cloud Translation API key>
# The GCP project needs billing enabled even for the free tier.
#
# The endpoint is only required by the commands that translate (`run`, `batch`)
# and only for the self-hosted engines; `estimate` and `eval` never need it.
#
# For a self-hosted Argos instance instead:
#   TOMESHIFT_NMT_PROVIDER=libretranslate
#   TOMESHIFT_NMT_ENDPOINT=http://localhost:5000/translate
TOMESHIFT_NMT_PROVIDER=http
TOMESHIFT_NMT_ENDPOINT=http://localhost:8081/translate
# Leave empty: injected from 1Password by the recipes that translate (.env.op).
TOMESHIFT_NMT_API_KEY=

# Translation memory (SQLite path)
TOMESHIFT_TM_PATH=./tm.sqlite

# Narrative bible (SQLite path) for literary mode / style-profile.
TOMESHIFT_NARRATIVE_PATH=./narrative.sqlite

# LLM completion cache (SQLite path): re-running over the same chapter reuses
# prior completions at no provider cost. Keyed by model + messages.
TOMESHIFT_LLM_CACHE_PATH=./llm_cache.sqlite

# NMT transient-failure retries
TOMESHIFT_NMT_MAX_ATTEMPTS=3
TOMESHIFT_NMT_RETRY_BASE_MS=200

# epubcheck QA gate: set the jar path (java -jar) or a PATH binary name.
# When neither resolves, the epubcheck gate is skipped (non-blocking).
TOMESHIFT_EPUBCHECK_JAR=
TOMESHIFT_EPUBCHECK_BIN=

# Per-book run timeout in seconds (0 = no timeout). Useful for long batch runs
# so a stuck provider call can't hang the whole series. SIGINT/SIGTERM also
# stop a batch cleanly between books.
TOMESHIFT_RUN_TIMEOUT_SECONDS=0

# LLM post-edit path (disabled in V1 by default; M3)
TOMESHIFT_LLM_ENABLED=false
TOMESHIFT_LLM_ENDPOINT=
# Leave empty: injected from 1Password by the recipes that call the LLM.
TOMESHIFT_LLM_API_KEY=
# Chat-completion client for literary mode and style-profile. OpenAI-compatible
# hosts include OpenAI and DeepSeek by changing only the base URL/model.
#
# "claude-cli" is EXPERIMENTAL: it drives the locally installed Claude Code CLI
# instead of the HTTP API, so a run is billed against a subscription seat rather
# than an API key. It needs no LLM_API_KEY, and LLM_MODEL takes a CLI alias
# ("opus", "sonnet", "haiku") or a full model name. Two consequences worth
# knowing: the per-book budget cap no longer describes real spend (set the
# model's published rates to keep a usable proxy), and prompt caching is left to
# the CLI — watch llm_cache_read_tokens in report.json to see whether it hits.
TOMESHIFT_LLM_CHAT_PROVIDER=openai
TOMESHIFT_LLM_BASE_URL=
TOMESHIFT_LLM_MODEL=
# Executable for CLI-backed chat providers. Empty uses "claude" from PATH.
TOMESHIFT_LLM_CLI_BIN=
# Segments per literary LLM call (0 = built-in default). Batches that come back
# incomplete are retried on smaller ones, so this trades calls against risk:
# raise it for large models, lower it for small local ones.
TOMESHIFT_LLM_BATCH_SIZE=0
# Escalate NMT segments with >= this many source chars to the LLM (0 = all)
TOMESHIFT_LLM_ESCALATE_MIN_CHARS=240

# Quality estimation (COMET-QE). When COMET_ENDPOINT is set, each NMT draft is
# scored (reference-free); segments scoring below ESCALATE_BELOW_SCORE are sent
# to the LLM, and the per-book average is reported. 0 disables score-based
# escalation (falls back to the length heuristic above).
TOMESHIFT_COMET_ENDPOINT=
TOMESHIFT_COMET_API_KEY=
TOMESHIFT_ESCALATE_BELOW_SCORE=0

# Cost guardrails. The per-book cap is compared against a token-based
# projection, so it only means something once the rates below are filled in.
# Size it on the model you actually run: a literary volume is ~4-6.50 $ on
# Sonnet-class models and ~1.60 $ on Haiku 4.5, so the 2.00 $ default will
# reject Sonnet runs on purpose.
TOMESHIFT_DAILY_BUDGET_USD=5.00
TOMESHIFT_MONTHLY_BUDGET_USD=50.00
TOMESHIFT_PER_BOOK_BUDGET_USD=2.00

# NMT draft cost (defaults to 0 = free local NMT).
# Google Cloud Translation is 20 $ per million characters = 0.02 $ per 1000.
TOMESHIFT_COST_PER_SEGMENT_USD=0
TOMESHIFT_COST_PER_1000_CHARS_USD=0
# Monthly free character allowance, shared between Cloud Translation Basic and
# Advanced, per GCP project. 500000 for Google; 0 for no free tier. Only the
# overflow is billed, and the counter is the run ledger — seed it honestly if
# characters were spent outside this pipeline in the current month.
TOMESHIFT_NMT_FREE_CHARS_PER_MONTH=0

# LLM token pricing. One model serves both `estimate` and the run guardrail.
# Example for claude-sonnet-5 (2 $/10 $ introductory rates run to 2026-08-31;
# standard rates are 3 $/15 $ with a 0.30 $ cache read — size the per-book cap
# on the standard figure so it does not start rejecting runs in September):
#   TOMESHIFT_LLM_MODEL=claude-sonnet-5
#   TOMESHIFT_LLM_INPUT_PER_MTOK_USD=3.00
#   TOMESHIFT_LLM_OUTPUT_PER_MTOK_USD=15.00
#   TOMESHIFT_LLM_CACHE_READ_PER_MTOK_USD=0.30
#   TOMESHIFT_LLM_TOKEN_MULTIPLIER=1.30
TOMESHIFT_LLM_INPUT_PER_MTOK_USD=0
TOMESHIFT_LLM_OUTPUT_PER_MTOK_USD=0
# Prompt-cache read rate. 0 means the provider does not cache, so the stable
# prefix is paid at full input rate on every call.
TOMESHIFT_LLM_CACHE_READ_PER_MTOK_USD=0
TOMESHIFT_LLM_CACHE_WRITE_MULTIPLIER=1.25
# FR/EN output token expansion.
TOMESHIFT_LLM_OUTPUT_EXPANSION=1.15
# Stable prefix in tokens, used by `estimate` only: a run measures the real
# prefix from the loaded bible instead.
TOMESHIFT_LLM_PROMPT_OVERHEAD_TOKENS=200
# Tokenizer density relative to the Sonnet 4.6 / Haiku 4.5 family the
# character heuristics were derived from. 1.30 for claude-sonnet-5 and the
# Opus 4.7 family: same sticker price, ~30% more tokens for the same text.
TOMESHIFT_LLM_TOKEN_MULTIPLIER=1.0
