# Copy this file to .env.local and adjust values.
# Keep this file to simple KEY=VALUE entries only.

# Core runtime
EPUB_TRANSLATOR_ENV=local
EPUB_TRANSLATOR_LOG_LEVEL=info
EPUB_TRANSLATOR_RUN_OUTPUT_DIR=./runs

# Translation provider. Supported: "http" (bundled dev server / our contract)
# or "libretranslate" (self-hosted LibreTranslate/Argos, real EN→FR).
# Default points at the bundled local NMT dev server (`just nmt-dev`).
# For real translations, run LibreTranslate and set:
#   EPUB_TRANSLATOR_NMT_PROVIDER=libretranslate
#   EPUB_TRANSLATOR_NMT_ENDPOINT=http://localhost:5000/translate
EPUB_TRANSLATOR_NMT_PROVIDER=http
EPUB_TRANSLATOR_NMT_ENDPOINT=http://localhost:8081/translate
EPUB_TRANSLATOR_NMT_API_KEY=

# Translation memory (SQLite path)
EPUB_TRANSLATOR_TM_PATH=./tm.sqlite

# NMT transient-failure retries
EPUB_TRANSLATOR_NMT_MAX_ATTEMPTS=3
EPUB_TRANSLATOR_NMT_RETRY_BASE_MS=200

# epubcheck QA gate: set the jar path (java -jar) or a PATH binary name.
# When neither resolves, the epubcheck gate is skipped (non-blocking).
EPUB_TRANSLATOR_EPUBCHECK_JAR=
EPUB_TRANSLATOR_EPUBCHECK_BIN=

# Per-book run timeout in seconds (0 = no timeout). Useful for long batch runs
# so a stuck provider call can't hang the whole series. SIGINT/SIGTERM also
# stop a batch cleanly between books.
EPUB_TRANSLATOR_RUN_TIMEOUT_SECONDS=0

# LLM post-edit path (disabled in V1 by default; M3)
EPUB_TRANSLATOR_LLM_ENABLED=false
EPUB_TRANSLATOR_LLM_PROVIDER=
EPUB_TRANSLATOR_LLM_ENDPOINT=
EPUB_TRANSLATOR_LLM_API_KEY=
# Escalate NMT segments with >= this many source chars to the LLM (0 = all)
EPUB_TRANSLATOR_LLM_ESCALATE_MIN_CHARS=240
EPUB_TRANSLATOR_COST_LLM_PER_SEGMENT_USD=0

# Quality estimation (COMET-QE). When COMET_ENDPOINT is set, each NMT draft is
# scored (reference-free); segments scoring below ESCALATE_BELOW_SCORE are sent
# to the LLM, and the per-book average is reported. 0 disables score-based
# escalation (falls back to the length heuristic above).
EPUB_TRANSLATOR_COMET_ENDPOINT=
EPUB_TRANSLATOR_COMET_API_KEY=
EPUB_TRANSLATOR_ESCALATE_BELOW_SCORE=0

# Cost guardrails
EPUB_TRANSLATOR_DAILY_BUDGET_USD=5.00
EPUB_TRANSLATOR_MONTHLY_BUDGET_USD=50.00
EPUB_TRANSLATOR_PER_BOOK_BUDGET_USD=2.00

# Cost model (defaults to 0 = free local NMT)
EPUB_TRANSLATOR_COST_PER_SEGMENT_USD=0
EPUB_TRANSLATOR_COST_PER_1000_CHARS_USD=0
